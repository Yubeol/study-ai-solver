VITE_API_TARGET=http://localhost:8000

# 문제 사진 인식(/ocr) 대기 시간(초). /qa와 따로 둔다.
# 서버 최악 경로(기본 설정): Gemini 2번 시도(60초×2 + 대기 2초) + PaddleOCR 첫 로드(약 60초) ≈ 182초
# 백엔드 PROBLEM_EXTRACT_MODEL=strong이면 strong→lite 폴백까지 시도해 약 300초로 늘어나니 그만큼 올린다
VITE_OCR_TIMEOUT_SECONDS=200

