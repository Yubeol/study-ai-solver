# ===== 공유 DB (팀 AWS PostgreSQL) =====
DB_HOST=
DB_PORT=5432
DB_NAME=cert_rag
DB_USER=
DB_PASSWORD=
# 내 작업 스키마 (팀 규격 테이블) / 내 서비스용 스키마
DB_SCHEMA=mingyu
DB_APP_SCHEMA=mingyu_app

# ===== LLM / Vision (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.7-flash

# ===== 임베딩 (로컬) =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 판정기 (Jev) =====
# none | jev_typesafe | jev_cloudflare | llm
JUDGE_PROVIDER=none
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== 파일 저장소 =====
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=