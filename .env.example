# ===== 공유 DB (팀 AWS PostgreSQL) =====
DB_HOST=
DB_PORT=5432
DB_NAME=cert_rag
DB_USER=
DB_PASSWORD=
# 내 작업 스키마 (팀 규격 테이블) / 내 서비스용 스키마
DB_SCHEMA=mingyu
DB_APP_SCHEMA=mingyu_app

# ===== LLM / Vision (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.7-flash

# ===== 임베딩 (로컬) =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 모델 캐시 위치(HF_HOME으로 전달, 모델 약 2.3GB). 비우면 ~/.cache/huggingface(C:). 영문 경로 권장
EMBEDDING_MODEL_DIR=E:\hf_models
# 임베딩 계산 장치. 기본 cpu(설치된 torch가 CPU 빌드). 비우거나 빼면 config 기본값 cpu
EMBEDDING_DEVICE=cpu
# 한 번에 임베딩할 청크 수(메모리 부족하면 줄임)
EMBEDDING_BATCH_SIZE=8
# 입력 최대 토큰 수(넘으면 잘림). 청크가 약 800자라 1024로 충분, 모델 최대 8192
EMBEDDING_MAX_SEQ_LENGTH=1024

# ===== 검색 =====
# 질문당 가져올 청크 수
SEARCH_TOP_K=5
# 리랭커에 넘길 벡터 후보 수(리랭커가 없으면 안 씀). 늘리면 질문당 리랭크 시간이 늘어남
SEARCH_CANDIDATES_N=10

# ===== 리랭커 (cross-encoder, 로컬) =====
# 비우면 리랭크 없이 벡터 순위 그대로. 캐시는 EMBEDDING_MODEL_DIR(HF_HOME). 비교 결과는 D-024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 질문+청크 최대 토큰(넘으면 잘림)
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=8
RERANKER_DEVICE=cpu
# 청크 쪽 입력: embedding_text(제목 경로+본문) | clean_text(본문만)
RERANKER_INPUT=embedding_text

# ===== "확인 불가" 판단: 벡터 하한 + 리랭커 3구간 (33문항 기준 잠정값, D-024) =====
# 1단계: 벡터 1위 점수(cosine)가 이보다 낮으면 바로 "자료에서 확인 불가"(확실히 먼 질문만 싸게 거름)
ANSWERABLE_MIN_VECTOR_SCORE=0.45
# 2단계: 리랭커 1위 점수(0~1)로 3구간(리랭커가 없으면 생략)
#   < MIN → "자료에서 확인 불가"(LLM 호출 없음) / MIN~CONFIDENT → 회색 구간(판정기 can_answer, 판정기 없으면 답변 + "근거 확신 낮음") / ≥ CONFIDENT → 답변
ANSWERABLE_MIN_RERANK_SCORE=0.03
ANSWERABLE_CONFIDENT_RERANK_SCORE=0.15

# ===== 검색 평가 (python -m app.retrieval.evaluate) =====
# 질문 세트 CSV(상대경로면 저장소 루트 기준). 형식은 ARCHITECTURE "검색 평가"
EVAL_QUESTIONS_PATH=data/eval/questions.csv
# 정답 청크 순위를 찾을 깊이(K보다 작으면 K). hit@K 자체는 SEARCH_TOP_K(또는 --k) 기준
EVAL_RANK_DEPTH=20
# "확인 불가" 판단용 1위 점수 임계값 후보(쉼표 구분)
EVAL_THRESHOLDS=0.40,0.45,0.50,0.55,0.60
# 리랭커 1위 점수 임계값 후보(쉼표 구분, 0~1). 2단계 표는 벡터 하한(0 + EVAL_THRESHOLDS) × 이 값
EVAL_RERANK_THRESHOLDS=0.01,0.05,0.1,0.15,0.2,0.3,0.5,0.7
# HTML 보고서(평가 실행 시 자동 생성, 다시 만들기: python -m app.retrieval.eval_report): 페이지 썸네일 가로 픽셀, 청크 텍스트 앞부분 글자 수
EVAL_REPORT_THUMB_WIDTH=320
EVAL_REPORT_TEXT_CHARS=200

# ===== 판정기 (Jev) =====
# none | jev_typesafe | jev_cloudflare | llm
JUDGE_PROVIDER=none
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== 파일 저장소 =====
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 업로드 =====
# 이미지 1장당 최대 크기(MB)
MAX_UPLOAD_MB=20

# ===== OCR (PaddleOCR, 인쇄체) =====
# 모델 캐시 위치(PADDLE_PDX_CACHE_HOME로 전달). 비우면 ~/.paddlex. 영문 경로 권장
OCR_MODEL_DIR=E:\paddle_models
OCR_LANG=korean
# 검출 모델만 지정하면 lang이 무시되므로 둘 다 지정한다(D-013). server_det는 CPU에서 너무 느림
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=korean_PP-OCRv5_mobile_rec
OCR_DEVICE=cpu

# ===== 팀 교재 반입 (D-014, D-018) =====
# page_map.json, pdf/, team_text/가 있는 폴더(상대경로면 저장소 루트 기준)
TEAM_IMPORT_DIR=data/raw/adsp
# 저장용 페이지 이미지 DPI. 팀 PDF는 1pt = 사진 1픽셀이라 72가 원본 해상도(장당 JPEG 약 1.5~2.8MB)
TEAM_IMPORT_RENDER_DPI=72
TEAM_IMPORT_JPEG_QUALITY=92
# 쪽번호 대조용 미리보기(--preview) DPI. 저장용과 별개
TEAM_IMPORT_PREVIEW_DPI=14
# dry-run 계획(plan.json)·미리보기 출력 폴더
REPORTS_DIR=data/reports

# ===== 이론 청킹 (D-019) =====
# 글자 수 기준. 청크는 페이지를 넘지 않고, 제목(절/항)이 바뀌면 새 청크
CHUNK_MAX_CHARS=800
# 긴 절을 나눌 때 앞 조각 끝 문단을 이 길이까지 다음 조각 앞에 다시 넣음
CHUNK_OVERLAP_CHARS=120
# 이보다 짧은 끝 조각은 앞 조각에 합침
CHUNK_MIN_CHARS=80
# "1. …", "2) …" 형태여도 이보다 긴 줄은 제목이 아니라 본문(목록)으로 봄
CHUNK_HEADING_MAX_CHARS=60
# 짧고(REVIEW_MAX_CHARS 미만) 본문 한글 비율이 낮은(REVIEW_MIN_HANGUL_RATIO 미만) 청크는
# needs_review=true로 저장해 검색(v_searchable_theory)에서 뺌 (R 출력·그림 글자 조각)
CHUNK_REVIEW_MAX_CHARS=80
CHUNK_REVIEW_MIN_HANGUL_RATIO=0.3
