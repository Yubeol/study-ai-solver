# ===== 공유 DB (팀 AWS PostgreSQL) =====
DB_HOST=
DB_PORT=5432
DB_NAME=cert_rag
DB_USER=
DB_PASSWORD=
# 내 작업 스키마 (팀 규격 테이블) / 내 서비스용 스키마
DB_SCHEMA=mingyu
DB_APP_SCHEMA=mingyu_app

# ===== LLM / Vision (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.7-flash

# ===== 임베딩 (로컬) =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 판정기 (Jev) =====
# none | jev_typesafe | jev_cloudflare | llm
JUDGE_PROVIDER=none
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== 파일 저장소 =====
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 업로드 =====
# 이미지 1장당 최대 크기(MB)
MAX_UPLOAD_MB=20

# ===== OCR (PaddleOCR, 인쇄체) =====
# 모델 캐시 위치(PADDLE_PDX_CACHE_HOME로 전달). 비우면 ~/.paddlex. 영문 경로 권장
OCR_MODEL_DIR=E:\paddle_models
OCR_LANG=korean
# 검출 모델만 지정하면 lang이 무시되므로 둘 다 지정한다(D-013). server_det는 CPU에서 너무 느림
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=korean_PP-OCRv5_mobile_rec
OCR_DEVICE=cpu
